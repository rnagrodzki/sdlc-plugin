{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/sdlc-launcher.sh",
            "args": ["hook", "session-start"],
            "timeout": 5000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/sdlc-launcher.sh",
            "args": ["hook", "block-askuserquestion-auto"],
            "timeout": 3000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/sdlc-launcher.sh",
            "args": ["hook", "post-tool-validate"],
            "timeout": 10000
          }
        ]
      },
      {
        "matcher": "Bash|TodoWrite",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/sdlc-launcher.sh",
            "args": ["hook", "pipeline-continue"],
            "timeout": 3000
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/sdlc-launcher.sh",
            "args": ["hook", "pre-compact-save"],
            "timeout": 5000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/sdlc-launcher.sh",
            "args": ["hook", "stop-state-save"],
            "timeout": 3000
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/sdlc-launcher.sh",
            "args": ["hook", "stop-plan-integrity"],
            "timeout": 3000
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/sdlc-launcher.sh",
            "args": ["hook", "stop-pipeline-continue"],
            "timeout": 3000
          }
        ]
      }
    ]
  }
}
