---
// The row of the 4 workflow changes (site-preview.src.html:452-457).
// It reads src/data/features.mjs. An item links to its product page only when
// the entry has claims.
import { BASE } from '../../site.config.mjs';
import { features } from '../data/features.mjs';
import { isRoutable } from '../lib/assets.mjs';
---

<ul class="changes">
  {
    features.map((feature) => (
      <li>
        <h2 class="change-title">
          {isRoutable(feature) ? <a href={`${BASE}/features/${feature.slug}/`}>{feature.title}</a> : feature.title}
        </h2>
        <p class="change-text">{feature.summary}</p>
      </li>
    ))
  }
</ul>

<style>
  .changes {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-28) var(--space-32);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .change-title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    margin: 0 0 var(--space-6);
    color: var(--accent-on-field);
  }
  .change-title a {
    color: inherit;
    text-underline-offset: var(--space-3);
  }
  .change-text {
    margin: 0;
    color: var(--muted);
    font-size: var(--text-md);
  }
  @media (max-width: 900px) {
    .changes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 520px) {
    .changes {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
