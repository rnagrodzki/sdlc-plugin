---
// The handover table of the all-skills page (reference site-preview.src.html:618-639):
// one strip for each row of the `## Handovers` table of docs/skills/README.md,
// in table order. Row i carries data-row="i", the index that `related` returns.
// A skill name with a map node is a chip that selects that node.
import { inlineParts } from '../lib/sequence-state.mjs';

type Handover = { From: string; To: string; 'Hands over': string };
interface Props {
  handovers: Handover[];
  nodeIds: Record<string, string>; // skill name -> map node id, for each name that has a node
}
const { handovers, nodeIds } = Astro.props;
---

<div class="block">
  <h2 class="h2">What each skill hands over</h2>
  <div class="hand-wrap">
    <table class="hand" data-hand>
      <thead><tr><th scope="col">From</th><th scope="col">Hands over</th><th scope="col">To</th></tr></thead>
      <tbody>
        {
          handovers.map((row, i) => (
            <tr data-row={i}>
              <td>
                {nodeIds[row.From] ? (
                  <button class="chip" type="button" data-go={nodeIds[row.From]}>
                    {row.From}
                  </button>
                ) : (
                  row.From
                )}
              </td>
              <td class="hand-what">
                {inlineParts(row['Hands over']).map((part) => (part.kind === 'code' ? <code>{part.value}</code> : part.value))}
              </td>
              <td>
                <span class="hand-to">
                  {nodeIds[row.To] ? (
                    <button class="chip" type="button" data-go={nodeIds[row.To]}>
                      {row.To}
                    </button>
                  ) : (
                    row.To
                  )}
                </span>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</div>

<style>
  .block {
    display: flex;
    flex-direction: column;
    gap: var(--space-20);
  }
  .h2 {
    font-family: var(--font-display);
    margin: 0;
    font-size: var(--text-h2);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-3);
    font-weight: var(--weight-semibold);
    text-wrap: balance;
  }
  /* The table keeps the reference minimum width of 640px and scrolls in its
     own frame on a phone. */
  .hand-wrap {
    overflow-x: auto;
  }
  .hand {
    width: 100%;
    min-width: 640px;
    border-collapse: separate;
    border-spacing: 0 var(--space-6);
    font-size: var(--text-md);
  }
  .hand th {
    text-align: left;
    font-weight: var(--weight-medium);
    font-size: var(--text-xs);
    color: var(--muted);
    padding: 0 var(--space-18) var(--space-2);
  }
  .hand td {
    padding: var(--space-12) var(--space-18);
    vertical-align: middle;
    background: var(--white-40);
    transition: background var(--dur-250);
  }
  .hand td:first-child {
    border-radius: var(--r-14) 0 0 var(--r-14);
  }
  .hand td:last-child {
    border-radius: 0 var(--r-14) var(--r-14) 0;
  }
  .hand code {
    color: var(--accent);
    font-weight: var(--weight-medium);
    font-size: var(--text-code);
  }
  .hand-what {
    color: var(--muted);
  }
  .hand tbody tr {
    transition:
      opacity var(--dur-250),
      transform var(--dur-300) var(--ease-glide);
  }
  .hand tbody tr:hover td {
    background: var(--white-70);
  }
  .hand tbody tr:global(.is-on) {
    transform: translateX(6px);
  }
  .hand tbody tr:global(.is-on) td {
    background: var(--paper);
    box-shadow: 0 14px 24px -20px var(--shade);
  }
  .hand-to {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    align-items: center;
  }
  .hand-to::before {
    content: '';
    flex: none;
    width: 18px;
    height: 2px;
    margin-right: var(--space-6);
    background: var(--accent);
    opacity: 0.6;
  }
  .chip {
    white-space: nowrap;
    font-family: var(--font-mono);
    font-weight: var(--weight-medium);
    font-size: var(--text-xs);
    color: var(--accent);
    padding: var(--space-3) var(--space-10);
    border-radius: var(--r-ctl);
    border: 1px solid var(--accent-30);
    background: var(--paper);
    cursor: pointer;
    transition:
      background var(--dur-200),
      color var(--dur-200),
      transform var(--dur-200);
  }
  .chip:hover {
    background: var(--accent);
    color: var(--on-accent);
    transform: translateY(-1px);
  }
</style>
