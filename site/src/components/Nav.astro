---
// The site nav of the reference (site-preview.src.html:407-411), as links.
// The Skills item is a menu: one direct link to each skill page, in the two
// groups of the `## Skill map` table of docs/skills/README.md. The menu is a
// <details> element, so it opens with no script. The script only closes it.
import { BASE } from '../../site.config.mjs';
import { readSkillMap, skillHref } from '../lib/skill-map.mjs';
import StarLink from './StarLink.astro';

interface Props {
  current?: 'home' | 'features' | 'skills' | 'docs' | 'releases';
}
const { current } = Astro.props;

const items = [
  { label: 'Home', href: `${BASE}/`, key: 'home' },
  { label: 'Skills', href: `${BASE}/skills/`, key: 'skills' },
  { label: 'Docs', href: `${BASE}/docs/`, key: 'docs' },
  { label: 'Release notes', href: `${BASE}/releases/`, key: 'releases' },
] as const;

const skills = readSkillMap();
const groups = [
  { label: 'Pipeline', items: skills.filter((s) => s.role === 'pipeline') },
  { label: 'Around the pipeline', items: skills.filter((s) => s.role === 'around') },
];
---

<header class="wrap nav-head">
  <nav class="nav" aria-label="Site">
    <a class="brand" href={`${BASE}/`}>sdlc</a>
    {
      items.map((item) =>
        item.key === 'skills' ? (
          <details class="menu" data-menu>
            <summary class:list={['nav-link', 'menu-sum', { 'is-here': item.key === current }]}>{item.label}</summary>
            <div class="menu-panel">
              <a class="menu-all" href={item.href}>
                How the skills work together
              </a>
              <div class="menu-cols">
                {groups.map((group) => (
                  <div class="menu-col">
                    <p class="menu-label">{group.label}</p>
                    <ul class="menu-list">
                      {group.items.map((skill) => (
                        <li>
                          <a class="menu-link" href={skillHref(skill.name, BASE)}>
                            /sdlc:{skill.name}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            </div>
          </details>
        ) : (
          <a class:list={['nav-link', { 'is-here': item.key === current }]} href={item.href} aria-current={item.key === current ? 'page' : undefined}>
            {item.label}
          </a>
        ),
      )
    }
    <StarLink />
  </nav>
</header>

<script>
  // Close the Skills menu on a click outside it and on Escape.
  const menu = document.querySelector<HTMLDetailsElement>('[data-menu]');
  if (menu) {
    document.addEventListener('click', (event) => {
      if (menu.open && !menu.contains(event.target as Node)) menu.open = false;
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
  }
</script>

<style>
  .nav-head {
    padding-block: var(--space-22) var(--space-44);
  }
  .nav {
    position: relative; /* the Skills menu panel hangs from the nav row */
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-10) var(--space-28);
  }
  .brand {
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    font-size: var(--text-brand);
    letter-spacing: var(--tracking-2);
    margin-right: auto;
    color: inherit;
    text-decoration: none;
  }
  .nav-link {
    color: var(--muted);
    font-size: var(--text-md);
    text-decoration: none;
  }
  .nav-link:hover {
    color: var(--ink);
  }
  .nav-link.is-here {
    color: var(--ink);
    font-weight: var(--weight-medium);
  }
  .menu-sum {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    cursor: pointer;
    list-style: none;
  }
  .menu-sum::-webkit-details-marker {
    display: none;
  }
  /* The caret of the menu. It turns when the menu is open. */
  .menu-sum::after {
    content: '';
    width: var(--space-6);
    height: var(--space-6);
    margin-top: calc(-1 * var(--space-3));
    border: solid currentColor;
    border-width: 0 1.5px 1.5px 0;
    transform: rotate(45deg);
    transition: transform var(--dur-200);
  }
  .menu[open] .menu-sum {
    color: var(--ink);
  }
  .menu[open] .menu-sum::after {
    margin-top: var(--space-3);
    transform: rotate(225deg);
  }
  .menu-panel {
    position: absolute;
    top: calc(100% + var(--space-10));
    right: 0;
    z-index: 20;
    width: min(34rem, 100%);
    display: flex;
    flex-direction: column;
    gap: var(--space-14);
    padding: var(--space-18) var(--space-20);
    border: 1px solid var(--line);
    border-radius: var(--r-16);
    background: var(--paper);
    box-shadow: 0 20px 44px -26px var(--shade);
  }
  .menu-all {
    align-self: flex-start;
    color: var(--accent);
    font-size: var(--text-md);
    font-weight: var(--weight-medium);
    text-underline-offset: var(--space-3);
  }
  .menu-cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-14) var(--space-24);
    padding-top: var(--space-14);
    border-top: 1px solid var(--line);
  }
  .menu-label {
    margin: 0 0 var(--space-6);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    color: var(--muted);
  }
  .menu-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .menu-link {
    display: block;
    padding: var(--space-5) 0;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--ink);
    text-decoration: none;
  }
  .menu-link:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: var(--space-3);
  }
  @media (max-width: 520px) {
    .menu-cols {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
