---
// The recommended workflow of Home, as one rail. It reads
// src/data/workflow.mjs: the 4 commands, the result that each one hands
// over, and the learn loop that joins the rail again before the plan.
// Each command links to its skill page.
//
// The page draws the rail complete. scripts/workflow-run.ts arms the rail and
// plays the run one time: a signal travels the rail, each station lights,
// each result shows on the rail, then the loop draws back. The script does
// not arm the rail under reduced motion.
import { BASE } from '../../site.config.mjs';
import { learnLoop, workflow } from '../data/workflow.mjs';
import { routeFor } from '../lib/doc-links.mjs';
import { skillHref } from '../lib/skill-map.mjs';

const guide = routeFor('docs/getting-started.md', { base: BASE });
// The loop joins the rail before this station.
const loopCol = workflow.findIndex((step) => step.skill === learnLoop.to);
---

<div class="flow" data-flow style={`--flow-count: ${workflow.length}; --loop-col: ${loopCol}`}>
  <div class="flow-panel island">
    <div class="flow-inner">
      <ol class="flow-steps">
        {
          workflow.map((step, i) => (
            <li class:list={['flow-step', { 'has-runs': step.runs, 'is-loop-target': i === loopCol }]} data-flow-part>
              <div class="flow-rail" aria-hidden="true">
                <span class="flow-node">{i + 1}</span>
                <span class="flow-seg">
                  <span class="flow-seg-fill" data-flow-timer />
                </span>
                {i === workflow.length - 1 && <span class="flow-end" />}
              </div>
              <div class="flow-body">
                <h3 class="flow-title">{step.title}</h3>
                <a class="flow-cmd" href={skillHref(step.skill, BASE)}>
                  {step.command}
                </a>
                <p class="flow-does">{step.does}</p>
                {step.runs && (
                  <ul class="flow-chips" aria-label={`Skills that /sdlc:${step.skill} runs for you`}>
                    {step.runs.map((name, n) => (
                      <li>
                        <a class="skill-chip flow-chip" href={skillHref(name, BASE)} style={`--i: ${n}`}>
                          {name}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
              <p class="flow-token">
                <span class="flow-sr">You get: </span>
                {step.result}
              </p>
            </li>
          ))
        }
      </ol>
      <div class="flow-loop" data-flow-part>
        <span class="flow-loop-main" aria-hidden="true"></span>
        <span class="flow-loop-back" data-flow-timer aria-hidden="true"></span>
        <p class="flow-loop-label">
          <svg class="flow-loop-icon" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
            <path d="M13.5 8a5.5 5.5 0 1 1-1.6-3.9M13.5 2v3h-3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
          <span>
            <a class="flow-loop-cmd" href={skillHref(learnLoop.skill, BASE)}>/sdlc:{learnLoop.skill}</a>
            {learnLoop.text}
          </span>
        </p>
      </div>
    </div>
  </div>
  <div class="flow-foot">
    <p class="flow-setup">
      Before the first run, do <a href={skillHref('setup', BASE)}>/sdlc:setup</a> one time in each repository.
      <a href={guide}>Read the getting started guide</a>.
    </p>
    <button class="flow-replay" type="button" data-flow-replay hidden>Replay the workflow</button>
  </div>
</div>

<script>
  import '../scripts/workflow-run.ts';
</script>

<style>
  .flow {
    --flow-gap: var(--space-32);
    --node: var(--space-32);
    --loop-row: var(--space-40);
    --loop-r: var(--space-16);
    /* The x position where the loop goes up: the middle of the gap before its station. */
    --loop-x: calc((100% + var(--flow-gap)) / var(--flow-count) * var(--loop-col) - var(--flow-gap) / 2);
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }
  .flow-panel {
    padding: var(--space-32) var(--space-32) var(--space-24);
  }
  .flow-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-28);
  }
  .flow-steps {
    display: grid;
    grid-template-columns: repeat(var(--flow-count), minmax(0, 1fr));
    column-gap: var(--flow-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .flow-step {
    --step-dur: var(--dur-1300);
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-20);
    min-width: 0;
  }
  /* The ship step runs 5 skills, so its part of the run takes longer. */
  .flow-step.has-runs {
    --step-dur: var(--dur-2100);
  }

  /* ---- the rail: a station, then the line to the next station ---- */
  .flow-rail {
    display: flex;
    align-items: center;
    height: var(--node);
    margin-right: calc(-1 * var(--flow-gap));
  }
  .flow-step:last-child .flow-rail {
    margin-right: 0;
  }
  .flow-node {
    flex: none;
    z-index: 1;
    box-sizing: border-box;
    display: grid;
    place-items: center;
    width: var(--node);
    height: var(--node);
    border: 2px solid var(--accent);
    border-radius: var(--r-round);
    background: var(--accent);
    color: var(--on-accent);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    transition:
      background var(--dur-250),
      border-color var(--dur-250),
      color var(--dur-250),
      box-shadow var(--dur-400);
  }
  .flow-seg {
    flex: 1;
    height: 2px;
    background: var(--ink-16);
  }
  .flow-seg-fill {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    background: var(--accent);
  }
  /* The signal: the lit head of the line while a step runs. */
  .flow-seg-fill::after {
    content: '';
    position: absolute;
    right: calc(-1 * var(--space-5));
    top: 50%;
    width: var(--space-10);
    height: var(--space-10);
    margin-top: calc(-1 * var(--space-5));
    border-radius: var(--r-round);
    background: var(--accent);
    box-shadow:
      0 0 0 4px var(--accent-25),
      0 0 14px 2px var(--accent-70);
    opacity: 0;
  }
  .flow-end {
    flex: none;
    width: var(--space-10);
    height: var(--space-10);
    border-radius: var(--r-round);
    background: var(--accent);
    transition: background var(--dur-250);
  }

  /* ---- the result of a step: a label on the line to the next station ---- */
  .flow-token {
    --token-shift: translate(-50%, -50%);
    position: absolute;
    top: calc(var(--node) / 2);
    left: calc((100% + var(--flow-gap) + var(--node)) / 2);
    z-index: 1;
    margin: 0;
    padding: var(--space-3) var(--space-12);
    border: 1px solid var(--accent-30);
    border-radius: var(--r-ctl);
    background: var(--paper);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    white-space: nowrap;
    transform: var(--token-shift);
    transition:
      opacity var(--dur-250),
      transform var(--dur-400) var(--ease-spring);
  }
  .flow-step:last-child .flow-token {
    left: calc((100% + var(--node) - var(--space-10)) / 2);
  }
  .flow-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* ---- the text of a station ---- */
  .flow-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-10);
    padding-right: var(--space-12);
  }
  /* The loop goes down the right edge, so the last station keeps clear of it. */
  .flow-step:last-child .flow-body {
    padding-right: var(--space-28);
  }
  .flow-title {
    font-family: var(--font-display);
    margin: 0;
    font-size: var(--text-2xl);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-3);
    font-weight: var(--weight-semibold);
  }
  .flow-cmd {
    max-width: 100%;
    overflow-wrap: anywhere;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--accent);
    text-underline-offset: var(--space-4);
    text-decoration-color: var(--accent-35);
  }
  .flow-cmd:hover {
    text-decoration-color: currentColor;
  }
  .flow-does {
    margin: 0;
    font-size: var(--text-md);
    color: var(--muted);
  }
  .flow-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* ---- the learn loop: from the end of the rail back to its station ---- */
  .flow-loop {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: var(--loop-row);
    padding-left: var(--loop-x);
  }
  /* Down the right edge, then left along the lower row. */
  .flow-loop-main {
    position: absolute;
    top: calc(var(--node) / 2 + var(--space-10));
    right: var(--space-4);
    bottom: calc(var(--loop-row) / 2 - 1px);
    left: calc(var(--loop-x) + var(--loop-r));
    border: solid var(--go);
    border-width: 0 2px 2px 0;
    border-bottom-right-radius: var(--loop-r);
    pointer-events: none;
  }
  /* Up the gap before the station, then into the rail. */
  .flow-loop-back {
    position: absolute;
    top: calc(var(--node) / 2 - 1px);
    bottom: calc(var(--loop-row) / 2 - 1px);
    left: calc(var(--loop-x) - 1px);
    width: var(--loop-r);
    border: solid var(--go);
    border-width: 2px 0 2px 2px;
    border-radius: var(--loop-r) 0 0 var(--loop-r);
    pointer-events: none;
  }
  .flow-loop-label {
    position: relative;
    z-index: 1;
    display: flex;
    gap: var(--space-8);
    align-items: center;
    margin: 0;
    padding: var(--space-6) var(--space-16);
    border: 1px solid var(--go);
    border-radius: var(--r-ctl);
    background: var(--paper);
    font-size: var(--text-sm);
    transition:
      opacity var(--dur-250),
      transform var(--dur-400) var(--ease-spring);
  }
  .flow-loop-icon {
    flex: none;
    color: var(--go);
  }
  .flow-loop-cmd {
    font-family: var(--font-mono);
    font-weight: var(--weight-medium);
    color: var(--go-text);
    text-underline-offset: var(--space-3);
  }

  /* ---- the run. The script arms the rail, then each part runs in turn. ---- */
  .flow.is-armed .flow-step:not(.is-run, .is-done) .flow-node {
    background: var(--paper);
    border-color: var(--ink-30);
    color: var(--muted);
  }
  .flow.is-armed .flow-step:not(.is-run, .is-done) .flow-seg-fill {
    width: 0;
  }
  .flow.is-armed .flow-step:not(.is-done) .flow-end {
    background: var(--ink-30);
  }
  .flow.is-armed .flow-step:not(.is-done) .flow-token {
    opacity: 0;
    transform: var(--token-shift) scale(0.7);
  }
  .flow-step.is-run .flow-node {
    box-shadow: 0 0 0 6px var(--accent-16);
    animation: flow-node-on var(--dur-600) var(--ease-spring) both;
  }
  .flow-step.is-run .flow-seg-fill {
    animation: flow-fill-x var(--step-dur) var(--ease-glide) forwards;
  }
  .flow-step.is-run .flow-seg-fill::after {
    opacity: 1;
  }
  /* The skills of the ship step light one after the other while the step runs. */
  .flow-step.is-run .flow-chip {
    animation: flow-chip-on var(--dur-400) var(--ease) both;
    animation-delay: calc(var(--i) * var(--dur-400));
  }
  .flow.is-armed .flow-loop:not(.is-done) :is(.flow-loop-main, .flow-loop-back) {
    clip-path: inset(0 0 100% 0);
  }
  .flow.is-armed .flow-loop:not(.is-done) .flow-loop-label {
    opacity: 0;
    transform: scale(0.9);
  }
  .flow.is-armed .flow-loop.is-run .flow-loop-main {
    animation: flow-draw-loop var(--dur-1300) var(--ease-draw) forwards;
  }
  .flow.is-armed .flow-loop.is-run .flow-loop-back {
    animation: flow-draw-up var(--dur-700) var(--ease-out) var(--dur-1300) forwards;
  }
  .flow.is-armed .flow-loop.is-run .flow-loop-label {
    opacity: 1;
    transform: none;
    transition-delay: var(--dur-900);
  }
  /* The loop arrives: its station takes the lesson. */
  .flow.is-armed:has(.flow-loop.is-done) .is-loop-target .flow-node {
    animation: flow-learn var(--dur-1300) var(--ease-out);
  }
  .flow.is-paused :is(.flow-node, .flow-seg-fill, .flow-chip, .flow-loop-main, .flow-loop-back) {
    animation-play-state: paused;
  }

  .flow-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8) var(--space-24);
    min-height: var(--space-28); /* the Replay button comes later and moves nothing */
  }
  .flow-setup {
    margin: 0;
    font-size: var(--text-md);
    color: var(--muted);
  }
  .flow-setup a {
    text-underline-offset: var(--space-3);
  }
  .flow-replay {
    padding: var(--space-3) var(--space-12);
    border: 1px solid var(--ink-30);
    border-radius: var(--r-ctl);
    background: transparent;
    color: var(--muted);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    cursor: pointer;
  }
  .flow-replay:hover {
    color: var(--ink);
    border-color: var(--ink);
  }

  @keyframes flow-fill-x {
    from {
      width: 0;
    }
    to {
      width: 100%;
    }
  }
  @keyframes flow-fill-y {
    from {
      height: 0;
    }
    to {
      height: 100%;
    }
  }
  @keyframes flow-node-on {
    from {
      transform: scale(0.6);
    }
    to {
      transform: scale(1);
    }
  }
  @keyframes flow-chip-on {
    to {
      background: var(--accent);
      border-color: var(--accent);
      color: var(--on-accent);
    }
  }
  /* The right edge shows from the top down, then the lower row shows from right to left. */
  @keyframes flow-draw-loop {
    from {
      clip-path: inset(0 0 100% calc(100% - var(--space-4)));
    }
    40% {
      clip-path: inset(0 0 0 calc(100% - var(--space-4)));
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  @keyframes flow-draw-up {
    from {
      clip-path: inset(100% 0 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  @keyframes flow-learn {
    from {
      box-shadow: 0 0 0 0 var(--go);
    }
    to {
      box-shadow: 0 0 0 18px transparent;
    }
  }

  /* A narrow window: the rail runs down the left side. */
  @media (max-width: 1000px) {
    .flow-panel {
      padding: var(--space-22) var(--space-20);
    }
    .flow-steps {
      grid-template-columns: minmax(0, 1fr);
    }
    .flow-step {
      display: grid;
      grid-template-columns: var(--node) minmax(0, 1fr);
      gap: var(--space-10) var(--space-16);
      padding-bottom: var(--space-28);
    }
    .flow-step:last-child {
      padding-bottom: 0;
    }
    .flow-rail {
      grid-row: 1 / span 2;
      flex-direction: column;
      height: auto;
      margin: 0 0 calc(-1 * var(--space-28));
    }
    .flow-step:last-child .flow-rail {
      margin: 0;
    }
    .flow-seg {
      width: 2px;
      height: auto;
    }
    .flow-seg-fill::after {
      display: none;
    }
    .flow.is-armed .flow-step:not(.is-run, .is-done) .flow-seg-fill {
      width: 100%;
      height: 0;
    }
    .flow-step.is-run .flow-seg-fill {
      animation-name: flow-fill-y;
    }
    .flow-body,
    .flow-step:last-child .flow-body {
      padding: var(--space-2) 0 0;
    }
    .flow-token,
    .flow-step:last-child .flow-token {
      --token-shift: translate(0, 0);
      position: static;
      grid-column: 2;
      justify-self: start;
      transform-origin: left center;
    }
    .flow-token::before {
      content: '\2192\00a0'; /* an arrow before the result of the step */
      color: var(--accent);
    }
    /* The loop is one label. Its fill is the timer of the part. */
    .flow-loop {
      position: relative;
      isolation: isolate;
      padding-left: 0;
      justify-content: stretch;
    }
    .flow-loop-main {
      display: none;
    }
    .flow-loop-back {
      inset: 0;
      z-index: -1;
      width: auto;
      border: 0;
      border-radius: var(--r-12);
      background: var(--go-tint);
    }
    .flow.is-armed .flow-loop.is-run .flow-loop-back {
      animation-delay: 0s;
    }
    .flow-loop-label {
      flex: 1;
      align-items: flex-start;
      padding: var(--space-10) var(--space-14);
      border-radius: var(--r-12);
      background: transparent;
    }
    .flow.is-armed .flow-loop.is-run .flow-loop-label {
      transition-delay: 0s;
    }
    .flow-loop-icon {
      margin-top: var(--space-3);
    }
  }
</style>
