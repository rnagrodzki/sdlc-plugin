---
// The Home page. The hero and the dashboard block come from the reference
// (site-preview.src.html:403-458, ref-home.jpeg). The stack, the workflow,
// the customization section, the self-healing section, the other benefits and
// the skill list are new: they use only existing tokens.
//
// The order of the page:
//   1. hero: the result, the install command, the stack and a sample run
//   2. the recommended workflow: 4 commands
//   3. the customization: the rules and the follow-up actions of the project
//   4. what makes the pipeline different: it heals and it learns
//   5. the dashboard
//   6. the other benefits
//   7. each skill, as a direct link
import BaseLayout from '../layouts/BaseLayout.astro';
import InstallCommand from '../components/InstallCommand.astro';
import StackStrip from '../components/StackStrip.astro';
import RunPanel from '../components/RunPanel.astro';
import WorkflowSteps from '../components/WorkflowSteps.astro';
import Customize from '../components/Customize.astro';
import Pillars from '../components/Pillars.astro';
import MediaFrame from '../components/MediaFrame.astro';
import BenefitGrid from '../components/BenefitGrid.astro';
import SkillIndex from '../components/SkillIndex.astro';
import { BASE } from '../../site.config.mjs';
import { features } from '../data/features.mjs';
import { workflow } from '../data/workflow.mjs';
import { isRoutable } from '../lib/assets.mjs';
import { readSkillMap } from '../lib/skill-map.mjs';

const sub =
  'sdlc is a plugin for Claude Code. Four commands take an idea to a reviewed pull request. The pipeline follows your rules, repairs its own failures and learns from each run.';

// The product pages that show the dashboard. A feature with no claims has no page and no link.
const dashboardPages = features.filter((f) => ['dashboard', 'stats'].includes(f.slug) && isRoutable(f));
const skillCount = readSkillMap().length;
---

<BaseLayout title="sdlc: from an idea to a reviewed pull request" description={sub} current="home">
  <div class="fields" aria-hidden="true">
    <span class="field f1"></span><span class="field f2"></span><span class="field f3"></span>
  </div>
  <div class="home wrap">
    <div class="hero">
      <div class="lead">
        <h1 class="h1">Give it an idea. Get a reviewed pull request.</h1>
        <p class="sub">{sub}</p>
        <InstallCommand />
        <StackStrip />
      </div>
      <RunPanel />
    </div>
    <section class="block" aria-labelledby="workflow-heading">
      <div class="block-head">
        <h2 class="h2" id="workflow-heading">The workflow: {workflow.length} commands.</h2>
        <p class="block-text">Four skills take an idea to a pull request. Each skill offers the next one.</p>
      </div>
      <WorkflowSteps />
    </section>
    <section class="block" aria-labelledby="customize-heading">
      <div class="block-head">
        <h2 class="h2" id="customize-heading">Your rules, in your words, at every step.</h2>
        <p class="block-text">Tell the pipeline how your team works. You write plain text in a config file, not code. Each run follows your rules and does your follow-up actions.</p>
      </div>
      <Customize />
    </section>
    <section class="block" aria-labelledby="pillars-heading">
      <div class="block-head">
        <h2 class="h2" id="pillars-heading">Use it more. Maintain it less.</h2>
        <p class="block-text">sdlc is self-healing and self-learning. It repairs a failed run, turns a failure into a guardrail, and keeps its own rules current while you work.</p>
      </div>
      <Pillars />
    </section>
    <section class="block" aria-labelledby="dashboard-heading">
      <div class="block-head">
        <h2 class="h2" id="dashboard-heading">Every run on one page.</h2>
        <p class="block-text">The dashboard shows each pipeline step by step, with the time of every step and the open issues.</p>
      </div>
      <MediaFrame assetId="dashboard-main" />
      {
        dashboardPages.length > 0 && (
          <ul class="more">
            {dashboardPages.map((feature) => (
              <li>
                <a href={`${BASE}/features/${feature.slug}/`}>{feature.title}</a>
              </li>
            ))}
          </ul>
        )
      }
    </section>
    <section class="block" aria-labelledby="benefits-heading">
      <div class="block-head">
        <h2 class="h2" id="benefits-heading">What else you get.</h2>
        <p class="block-text">Each benefit names the skills that give it. Select a skill to read its page.</p>
      </div>
      <BenefitGrid />
    </section>
    <section class="block" aria-labelledby="skills-heading">
      <div class="block-head">
        <h2 class="h2" id="skills-heading">All {skillCount} skills.</h2>
        <p class="block-text">
          The workflow needs {workflow.length} of them. Use the others to run one step by hand.
          <a href={`${BASE}/skills/`}>See how the skills work together</a>.
        </p>
      </div>
      <SkillIndex core={workflow.map((step) => step.skill)} />
    </section>
  </div>
</BaseLayout>

<style>
  /* The colour fields behind the glass. They sit under the page content and
     never cause a horizontal scroll. */
  .fields {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1300px;
    overflow: hidden;
    z-index: -1;
    pointer-events: none;
  }
  .field {
    position: absolute;
    border-radius: var(--r-round);
    filter: blur(70px);
  }
  .f1 {
    width: 540px;
    height: 540px;
    right: -90px;
    top: 30px;
    background: var(--f1);
  }
  .f2 {
    width: 420px;
    height: 420px;
    right: 30%;
    top: 280px;
    background: var(--f2);
  }
  .f3 {
    width: 480px;
    height: 480px;
    left: -120px;
    top: 760px;
    background: var(--f1);
  }
  .home {
    display: flex;
    flex-direction: column;
    gap: var(--space-64);
  }
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: var(--space-40) var(--space-64);
    align-items: center;
  }
  .lead {
    display: flex;
    flex-direction: column;
    gap: var(--space-22);
  }
  .h1 {
    font-family: var(--font-display);
    margin: 0;
    text-wrap: balance;
    font-size: var(--text-h1);
    line-height: var(--leading-h1);
    letter-spacing: var(--tracking-4);
    font-weight: var(--weight-semibold);
  }
  .h2 {
    font-family: var(--font-display);
    margin: 0;
    font-size: var(--text-h2);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-3);
    font-weight: var(--weight-semibold);
    text-wrap: balance;
  }
  .sub {
    margin: 0;
    color: var(--muted);
    font-size: var(--text-xl);
    line-height: var(--leading-sub);
    max-width: 54ch;
  }
  .block {
    display: flex;
    flex-direction: column;
    gap: var(--space-28);
  }
  /* The heading of a section, with its intro text below it. */
  .block-head {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }
  .block-text {
    margin: 0;
    color: var(--muted);
    font-size: var(--text-xl);
    line-height: var(--leading-sub);
    max-width: 62ch;
  }
  .block-text a {
    text-underline-offset: var(--space-3);
  }
  .more {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8) var(--space-28);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-md);
    font-weight: var(--weight-medium);
  }
  .more a {
    color: var(--accent);
    text-underline-offset: var(--space-3);
  }
  @media (max-width: 900px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
