---
// The release notes: /releases/ shows CHANGELOG.md. The file lists the newest version first.
import { getEntry, render } from 'astro:content';
import DocLayout from '../layouts/DocLayout.astro';
import { tocEntries } from '../lib/doc-meta.mjs';

const entry = await getEntry('root', 'changelog');
if (!entry) throw new Error('CHANGELOG.md is not in the root collection');
const { Content, headings } = await render(entry);
const lead = 'What changed in each version of the sdlc plugin, the newest version first.';
---

<DocLayout
  title="Release notes | sdlc"
  description={lead}
  current="releases"
  heading="Release notes"
  lead={lead}
  crumb="sdlc plugin"
  toc={tocEntries(headings, { maxDepth: 2 })}
>
  <Content />
</DocLayout>
