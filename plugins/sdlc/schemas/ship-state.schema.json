{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/rnagrodzki/sdlc-plugin/main/plugins/sdlc/schemas/ship-state.schema.json",
  "title": "Ship State",
  "description": "Validates .sdlc-v2/execution/ship-*.json",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "branch": {
      "type": "string"
    },
    "worktree": {
      "type": "string"
    },
    "pipelineStatus": {
      "type": "string",
      "description": "Set by the cleanup/cleanup-pipeline actions to stamp the pipeline terminal (instead of deleting the state file), so state survives for later reads until GC's TTL prunes it."
    },
    "pipelineCompletedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp paired with pipelineStatus, set by the cleanup/cleanup-pipeline actions."
    },
    "flags": {
      "type": "object",
      "properties": {
        "auto": {
          "type": "boolean"
        },
        "skip": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["execute", "commit", "review", "received-review", "commit-fixes", "version", "pr", "verify-pipeline", "await-remote-review"]
          }
        },
        "preset": {
          "oneOf": [
            {
              "type": "string",
              "enum": ["A", "B", "C"]
            },
            {
              "type": "null"
            }
          ]
        },
        "bump": {
          "oneOf": [
            {
              "type": "string",
              "enum": ["major", "minor", "patch"]
            },
            {
              "type": "null"
            }
          ]
        },
        "draft": {
          "type": "boolean"
        }
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "enum": ["execute", "commit", "review", "received-review", "commit-fixes", "version", "verify-openspec", "archive-openspec", "pr", "verify-pipeline", "await-remote-review", "learnings-commit"]
          },
          "status": {
            "type": "string",
            "enum": ["pending", "in_progress", "completed", "skipped", "failed"]
          },
          "kind": {
            "type": "string",
            "description": "\"tracked\" (has a begin-step/complete-step lifecycle) or \"inline\" (recorded via the generic \"decide\" action). Absent on state files written before this scaffold existed — such entries still validate.",
            "enum": ["tracked", "inline"]
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "completedAt": {
            "type": "string",
            "format": "date-time"
          },
          "result": {
            "type": "string"
          },
          "condition": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "error": {
            "type": "string"
          }
        },
        "required": ["name", "status"]
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step": {
            "type": "string"
          },
          "decision": {
            "type": "string"
          }
        },
        "required": ["step", "decision"]
      }
    },
    "deferredFindings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low"]
          },
          "file": {
            "type": "string"
          },
          "line": {
            "oneOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": {
            "type": "string"
          }
        },
        "required": ["severity", "file", "title"]
      }
    },
    "lastFailedStep": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Name of the most recent failed step. Set by fail (R-TASK-17)."
    },
    "issues": {
      "type": "array",
      "description": "Structured issue accumulator appended by fail (R-TASK-17). Mirrors deferredFindings above and execute-state.schema.json's issues[].",
      "items": {
        "type": "object",
        "properties": {
          "wave": {
            "type": "integer"
          },
          "step": {
            "type": "string"
          },
          "taskId": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          }
        },
        "required": ["severity", "category", "summary", "timestamp"],
        "additionalProperties": false
      }
    },
    "sideEffects": {
      "type": "object",
      "description": "Idempotency journal keyed by step name, recording each step's verified git/PR side effect so a resumed pipeline can skip re-doing work that already landed. Written by ship_verify_side_effect; consulted by begin-step's alreadyDone flag.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["release-intent", "pr", "sha"]
          },
          "ref": {
            "type": "string"
          },
          "verifiedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": ["kind", "ref", "verifiedAt"],
        "additionalProperties": false
      }
    }
  },
  "required": ["version", "startedAt", "branch", "flags", "steps"],
  "additionalProperties": false
}
