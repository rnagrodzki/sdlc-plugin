{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/rnagrodzki/sdlc-plugin/main/plugins/sdlc/schemas/ship-state.schema.json",
  "title": "Ship State",
  "description": "Validates .sdlc-v2/runs/ship-*.json",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "sessionId": {"type": ["string", "null"], "description": "Claude Code session ID passed to init; null when init got none."},
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "branch": {
      "type": "string"
    },
    "worktree": {
      "type": "string"
    },
    "pipelineStatus": {
      "type": "string",
      "description": "Set by the cleanup/cleanup-pipeline actions to stamp the pipeline terminal (instead of deleting the state file), so state survives for later reads until GC's TTL prunes it."
    },
    "pipelineCompletedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp paired with pipelineStatus, set by the cleanup/cleanup-pipeline actions."
    },
    "flags": {
      "type": "object",
      "properties": {
        "auto": {
          "type": "boolean"
        },
        "quick": {
          "type": "boolean",
          "description": "True when ship_prepare was called with quick: steps then come from the [ship] quick profile."
        },
        "steps": {
          "type": "array",
          "description": "Resolved step list for this run: CLI steps, else the quick profile, else config, else the built-in default.",
          "items": {
            "type": "string"
          }
        },
        "rebase": {
          "type": "string",
          "description": "Rebase policy for this run (e.g. auto or skip): CLI value, else config (a bool becomes auto/skip), else auto."
        },
        "openspecChange": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "OpenSpec change for verify-openspec/archive-openspec: the explicit input, else the plan's **Source:** openspec/changes/<name>/ header, else null."
        },
        "bump": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^(major|minor|patch|[a-z][a-z0-9]*)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "draft": {
          "type": "boolean"
        }
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "enum": ["execute", "commit", "review", "harden", "received-review", "commit-fixes", "verify-openspec", "archive-openspec", "pr", "verify-pipeline", "await-remote-review", "learnings-commit"]
          },
          "status": {
            "type": "string",
            "enum": ["pending", "in_progress", "completed", "skipped", "failed"]
          },
          "kind": {
            "type": "string",
            "description": "\"tracked\" (has a begin-step/complete-step lifecycle) or \"inline\" (recorded via the generic \"decide\" action). Absent on state files written before this scaffold existed — such entries still validate.",
            "enum": ["tracked", "inline"]
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "completedAt": {
            "type": "string",
            "format": "date-time"
          },
          "result": {
            "type": "string"
          },
          "condition": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "error": {
            "type": "string"
          }
        },
        "required": ["name", "status"]
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step": {
            "type": "string"
          },
          "decision": {
            "type": "string"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": ["step", "decision"]
      }
    },
    "deferredFindings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "severity": {
            "type": "string",
            "description": "Review severity of the finding, lowercased by the defer action. info is included: the default reviewThreshold is info, so a default run defers nothing as below-threshold, but a project on low defers exactly its info findings.",
            "enum": ["critical", "high", "medium", "low", "info"]
          },
          "file": {
            "type": "string"
          },
          "line": {
            "oneOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "description": "Why the finding was deferred instead of fixed. Written by defer since the deferred-reason change; absent on entries recorded before it, so not required.",
            "enum": ["below-threshold", "needs-direction", "disagree", "wont-fix"]
          },
          "description": {
            "type": "string",
            "description": "The deferring agent's own reasoning (detail.description; defaults to title). Written by defer since the harden step started reading it; absent on older entries, so not required."
          }
        },
        "required": ["severity", "file", "title"]
      }
    },
    "lastFailedStep": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Name of the most recent failed step. Set by fail (R-TASK-17)."
    },
    "issues": {
      "type": "array",
      "description": "Structured issue accumulator appended by fail (R-TASK-17). Mirrors deferredFindings above and execute-state.schema.json's issues[].",
      "items": {
        "type": "object",
        "properties": {
          "wave": {
            "type": "integer"
          },
          "step": {
            "type": "string"
          },
          "taskId": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          }
        },
        "required": ["severity", "category", "summary", "timestamp"],
        "additionalProperties": false
      }
    },
    "sideEffects": {
      "type": "object",
      "description": "Idempotency journal keyed by step name (\"<step>#<n>\" for the n-th entry of a name that occurs more than once in steps[], e.g. \"commit#2\"), recording each step's verified git/PR side effect so a resumed pipeline can skip re-doing work that already landed. Written by ship_verify_side_effect; consulted by begin-step's alreadyDone flag.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["pr", "sha"]
          },
          "ref": {
            "type": "string"
          },
          "verifiedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": ["kind", "ref", "verifiedAt"],
        "additionalProperties": false
      }
    },
    "sources": {
      "type": "object",
      "description": "Per-flag precedence trace (R6): records which tier won for each key in flags (\"cli\", \"config\", \"config (version.preRelease)\", \"config (version.preReleasePolicy)\", \"config (version.preReleasePolicy enforced over cli)\", \"quick\", \"plan\" (openspecChange read from the plan's **Source:** openspec/changes/<name>/ header), or \"default\"). Written by ship_prepare alongside flags.",
      "additionalProperties": {
        "type": "string"
      }
    },
    "versionCfg": {
      "type": "object",
      "description": "Raw [version] config section snapshot as read by ship_prepare at flag-resolution time (config.ReadSection), for diagnosability. Shape mirrors the project's [version] TOML table and is intentionally not enumerated here to avoid drift."
    },
    "binaryVersion": {
      "type": "object",
      "description": "Build metadata of the sdlc binary that produced this state file (version.GetBuildInfo).",
      "properties": {
        "pluginVersion": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        },
        "buildTime": {
          "type": "string"
        }
      }
    },
    "healing": {
      "type": "object",
      "description": "Self-healing ledger of the ship run, written only by ship_state healing_record while the run is live. Read verbatim into read's reportData.healing and used for reportData.reviewLedger.",
      "properties": {
        "reviewTotal": {
          "type": "object",
          "description": "The review step's own finding count. A later review-total record replaces it.",
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0
            },
            "dimensions": {
              "type": "integer",
              "minimum": 0
            },
            "recordedAt": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": ["total", "dimensions", "recordedAt"],
          "additionalProperties": false
        },
        "fixed": {
          "type": "array",
          "description": "Findings fixed and verified by received-review. Deduplicated on (origin, file, line, title).",
          "items": {
            "type": "object",
            "properties": {
              "origin": {
                "type": "string",
                "enum": ["local-review", "pr-comment"]
              },
              "severity": {
                "type": "string",
                "enum": ["critical", "high", "medium", "low", "info"]
              },
              "file": {
                "type": "string"
              },
              "line": {
                "oneOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "title": {
                "type": "string"
              },
              "recordedAt": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": ["origin", "severity", "file", "title", "recordedAt"],
            "additionalProperties": false
          }
        },
        "hardened": {
          "type": "array",
          "description": "Harden runs, one per trigger. A done record replaces a started record with the same trigger; a started record with no done record marks an interrupted run.",
          "items": {
            "type": "object",
            "properties": {
              "phase": {
                "type": "string",
                "enum": ["started", "done"]
              },
              "trigger": {
                "type": "string"
              },
              "classification": {
                "type": "string"
              },
              "applied": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "surface": {
                      "type": "string",
                      "enum": ["plan-guardrails", "execute-guardrails", "review-dimensions", "copilot-instructions", "error-report-skill", "skill-recommendation"]
                    },
                    "action": {
                      "type": "string"
                    },
                    "targetFile": {
                      "type": "string"
                    }
                  },
                  "required": ["surface", "action", "targetFile"],
                  "additionalProperties": false
                }
              },
              "skipped": {
                "type": "integer",
                "minimum": 0
              },
              "recordedAt": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": ["phase", "trigger", "classification", "applied", "skipped", "recordedAt"],
            "additionalProperties": false
          }
        }
      }
    }
  },
  "required": ["version", "startedAt", "branch", "flags", "steps"],
  "additionalProperties": false
}
